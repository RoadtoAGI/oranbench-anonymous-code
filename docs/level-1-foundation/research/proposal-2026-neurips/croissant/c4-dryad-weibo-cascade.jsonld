  "@type": "sc:Dataset",
  "name": "OranBench C4 Dryad Weibo Cascade Candidate",
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "description": "Croissant metadata draft for the C4 diffusion-calibration card. The Dryad dataset is a public Weibo cascade candidate; event-time schema suitability remains pending before empirical reporting.",
