  "@type": "sc:Dataset",
  "name": "OranBench C1 KuaiRand Pure Random Exposure Slice",
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "description": "Croissant metadata for the C1 randomized recommender OPE card. The processed file is derived from KuaiRand-Pure random-exposure logs and adds known uniform propensity pi0(a|x)=1/7583 for the random pool.",
  "url": "https://zenodo.org/records/10439422",
  "license": "https://creativecommons.org/licenses/by-nc-sa/4.0/",
  "version": "0.1.0",
  "citeAs": "Gao et al. (2022), KuaiRand: an unbiased sequential recommendation dataset with randomly exposed videos.",
