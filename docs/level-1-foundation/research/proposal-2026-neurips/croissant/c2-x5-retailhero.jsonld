  "@type": "sc:Dataset",
  "name": "OranBench C2 X5 RetailHero Uplift",
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "description": "Croissant metadata for the C2 uplift-ranking card. The processed file contains client-level treatment, outcome, RFM, and demographic features derived from public X5 RetailHero uplift data.",
  "url": "https://www.uplift-modeling.com/en/latest/api/datasets/fetch_x5.html",
  "license": "https://www.uplift-modeling.com/en/latest/",
  "version": "0.1.0",
  "citeAs": "X5 RetailHero uplift dataset as distributed through scikit-uplift.",
